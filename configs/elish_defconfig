# elish 内核配置 —— 阶段 1 重试②：umi 运行时开关 + 源码构建必需的归档
#
# 依据：reAAAq/UniXNU-umi "Early kernel entry/MMU/arm_vm_init verified 2026-10-20"。
# 运行时开关对齐 umi（CRYPTO_BOOTSTRAP=source、NATIVE_AES/TRUST_CACHE_RUNTIME/
# CS_HASH_CACHE/PAN/DT_PANIC_REGION 全关 —— 这些决定内核代码布局与 __PRELINK 段）；
# 但 umi 走 donor 预链接（[kernel.prelink]），我们走 build-xnu-4k-baseline.sh 源码构建，
# 其 source bootstrap 仍引用 _corecrypto_kext_start（run 41190148854 链接失败实证），
# 故保留 6 条构建归档（corecrypto×2 / arm-driver×2 / libpthread / link-stubs）。
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/link-stubs/libLinkStubs.a"
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_SHENG_PMGR=n
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_AES=n
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_TRUST_CACHE_RUNTIME=n
CONFIG_XNU_SOURCE_MOCKFS=n
CONFIG_XNU_NATIVE_CS_HASH_CACHE=n
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=n
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_OWNER_CACHE_MOUNT=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_NATIVE_PAN=n
CONFIG_XNU_DT_PANIC_REGION=n
CONFIG_XNU_BOOT_PROGRESS=n
